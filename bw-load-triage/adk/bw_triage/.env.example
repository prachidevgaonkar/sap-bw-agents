# Option A: Gemini API key from Google AI Studio (quickest for a demo)
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=paste-your-key-here

# Option B: your Google Cloud project (Vertex AI). Comment out option A and use:
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: model for all three agents
# BW_AGENT_MODEL=gemini-3.8-flash
